{
  "name": "dht-proxy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "bun --bun biome check .",
    "lint:fix": "bun --bun biome check --write .",
    "lint:ci": "bun --bun biome ci .",
    "format": "bun --bun biome format --write .",
    "typecheck": "bun --bun next typegen && bun --bun tsc --noEmit",
    "db:generate": "bun --env-file=.env.local drizzle-kit generate",
    "db:migrate": "bun --env-file=.env.local drizzle-kit migrate",
    "db:push": "bun --env-file=.env.local drizzle-kit push",
    "db:studio": "bun --env-file=.env.local drizzle-kit studio",
    "test": "bun test"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@maxmind/geoip2-node": "^7.1.0",
    "bencode": "^4.0.1",
    "better-auth": "^1.7.1",
    "bittorrent-dht": "^11.0.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.33.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "parse-torrent": "^11.0.24",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-country-flag": "^3.1.0",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
