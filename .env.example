# Docker Compose
COMPOSE_PROJECT_NAME=dht-proxy
COMPOSE_FILE=docker/docker-compose.base.yml:docker/docker-compose.dev.yml

DOCKER_IMAGE=ghcr.io/janhouse/dht-proxy

# Database
DATABASE_URL=postgresql://dhtproxy:dhtproxy@localhost:5432/dhtproxy
POSTGRES_USER=dhtproxy
POSTGRES_PASSWORD=dhtproxy
POSTGRES_DB=dhtproxy

# Auth
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
BETTER_AUTH_URL=http://localhost:3000
OIDC_ISSUER_URL=https://authentik.example.com/application/o/dht-proxy/
OIDC_CLIENT_ID=dht-proxy
OIDC_CLIENT_SECRET=change-me

# Announce
ANNOUNCE_URL=http://localhost:3000/api/announce

# GeoIP (MaxMind GeoLite2)
GEOIP_DB_PATH=./geoip/GeoLite2-City.mmdb
GEOIPUPDATE_ACCOUNT_ID=your-account-id
GEOIPUPDATE_LICENSE_KEY=your-license-key

# Access control
DHT_PROXY_PUBLIC=true
DHT_PROXY_API_TOKEN=           # Required when DHT_PROXY_PUBLIC=false

